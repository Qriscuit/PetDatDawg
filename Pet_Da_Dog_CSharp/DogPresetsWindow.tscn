[node name="DogPresetsWindow" type="Window"]
title = "Pet Da Dog · Presets"
size = Vector2i(640, 600)
min_size = Vector2i(520, 400)
visible = false
theme = ExtResource("2")
script = ExtResource("1")

[node name="Background" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
