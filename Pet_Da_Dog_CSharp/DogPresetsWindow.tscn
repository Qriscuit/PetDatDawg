[node name="Panel" type="PanelContainer" parent="Background/Margin"]
layout_mode = 2
theme_override_styles/panel = ExtResource("4")

[node name="Content" type="VBoxContainer" parent="Background/Margin/Panel"]
layout_mode = 2
