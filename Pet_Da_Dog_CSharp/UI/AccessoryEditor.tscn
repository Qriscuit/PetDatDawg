[sub_resource type="AtlasTexture" id="Sample_0"]
atlas = ExtResource("asset_0")
region = Rect2(29, 128, 991, 804)
filter_clip = true

[sub_resource type="Shader" id="SampleJpegCutoutShader"]
code = "shader_type canvas_item;
render_mode unshaded;
varying vec4 item_color;
void vertex() { item_color = COLOR; }
void fragment() {
    vec4 pixel = texture(TEXTURE, UV);
    float alpha = smoothstep(0.06, 0.30, max(pixel.r, max(pixel.g, pixel.b)));
    vec3 rgb = alpha > 0.0 ? min(vec3(1.0), pixel.rgb / max(alpha, 0.0001)) : vec3(1.0);
    COLOR = vec4(rgb, pixel.a * alpha) * item_color;
}
"

[sub_resource type="ShaderMaterial" id="SampleJpegCutoutMaterial"]
shader = SubResource("SampleJpegCutoutShader")

