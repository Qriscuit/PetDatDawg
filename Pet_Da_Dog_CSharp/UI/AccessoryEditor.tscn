[sub_resource type="Shader" id="SampleJpegCutoutShader"]
code = "shader_type canvas_item;\nrender_mode unshaded;\nvarying vec4 item_color;\nvoid vertex() { item_color = COLOR; }\nvoid fragment() {\n    vec4 pixel = texture(TEXTURE, UV);\n    float alpha = smoothstep(0.06, 0.30, max(pixel.r, max(pixel.g, pixel.b)));\n    vec3 rgb = alpha > 0.0 ? min(vec3(1.0), pixel.rgb / max(alpha, 0.0001)) : vec3(1.0);\n    COLOR = vec4(rgb, pixel.a * alpha) * item_color;\n}\n"

[sub_resource type="ShaderMaterial" id="SampleJpegCutoutMaterial"]
shader = SubResource("SampleJpegCutoutShader")

