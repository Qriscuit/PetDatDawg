[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://Scripts/PatrolRouteToolbar.cs" id="1_script"]
[ext_resource type="Theme" path="res://UI/Theme/DefaultTheme.tres" id="2_theme"]
[ext_resource type="StyleBox" path="res://UI/Theme/Panel.tres" id="3_panel"]

[node name="PatrolRouteToolbar" type="Window"]
transparent_bg = false
transparent = false
title = "Pet Da Dog · Patrol route"
size = Vector2i(590, 178)
visible = true
unresizable = true
always_on_top = true
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Background" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = ExtResource("3_panel")

[node name="Content" type="VBoxContainer" parent="Background"]
layout_mode = 2
theme_override_constants/separation = 7

[node name="Heading" type="Label" parent="Background/Content"]
layout_mode = 2
theme_type_variation = &"WoodlandHeading"
text = "Set your patrol route"

[node name="Instructions" type="Label" parent="Background/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.372549, 0.396078, 0.298039, 1)
theme_override_font_sizes/font_size = 13
text = "Click to add stops • Drag to move • Right-click to remove"
autowrap_mode = 3

[node name="PatrolDraftSummary" type="Label" parent="Background/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "3 stops · 1 → 2 → 3 → 1"
autowrap_mode = 3

[node name="Actions" type="HBoxContainer" parent="Background/Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PatrolUndoLast" type="Button" parent="Background/Content/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
tooltip_text = "Remove the last stop (Backspace)."
theme_type_variation = &"SecondaryButton"
text = "Undo last"

[node name="PatrolClearDraft" type="Button" parent="Background/Content/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
tooltip_text = "Remove all stops from this draft."
theme_type_variation = &"SecondaryButton"
text = "Clear"

[node name="Spacer" type="Control" parent="Background/Content/Actions"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="PatrolCancel" type="Button" parent="Background/Content/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
tooltip_text = "Discard changes (Escape)."
theme_type_variation = &"SecondaryButton"
text = "Cancel"

[node name="PatrolDone" type="Button" parent="Background/Content/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
tooltip_text = "Save this route and start patrolling (Enter)."
theme_type_variation = &"ActionButton"
text = "Done"

[node name="PatrolToolbarSaveStatus" type="Label" parent="Background/Content"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.643137, 0.313725, 0.192157, 1)
theme_override_font_sizes/font_size = 12
text = "Last save failed. Done will try saving this route again."
autowrap_mode = 3
